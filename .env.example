MYCELIA_CMS_HOST=127.0.0.1
MYCELIA_CMS_PORT=8088
MYCELIA_DB_HOST=127.0.0.1
MYCELIA_DB_PORT=4555
MYCELIA_SDK_DLL=vendor/CC_OpenCl.dll
MYCELIA_CMS_MASTER_KEY=
MYCELIA_CMS_SESSION_KEY=
MYCELIA_CMS_ADMIN_USER=admin
MYCELIA_CMS_ADMIN_PASSWORD_HASH=
MYCELIA_CMS_BACKUP_DIR=data/backups
MYCELIA_CMS_COOKIE_SECURE=0
MYCELIA_CMS_SESSION_MINUTES=30
MYCELIA_CMS_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# 0 = kein Proxy-Trust. Bei genau einem lokalen TLS-Reverse-Proxy: 1.
MYCELIA_CMS_TRUSTED_PROXY_HOPS=0

# Optional newsletter SMTP. Newsletter bleibt fail-closed deaktiviert,
# solange Host, Absender und öffentliche Basis-URL fehlen.
MYCELIA_CMS_PUBLIC_BASE_URL=
MYCELIA_SMTP_HOST=
MYCELIA_SMTP_PORT=587
MYCELIA_SMTP_USERNAME=
MYCELIA_SMTP_PASSWORD=
MYCELIA_SMTP_FROM_EMAIL=
MYCELIA_SMTP_FROM_NAME=Mycelia
MYCELIA_SMTP_MODE=starttls

MYCELIA_DB_POOL_SIZE=4
